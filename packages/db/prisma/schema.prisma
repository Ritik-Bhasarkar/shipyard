// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId        String         @id @default(uuid())
  username      String         @unique
  password      String
  memberships   Membership[]
  issueMappings IssueMapping[]
}

model Organization {
  orgId          String       @id @default(uuid())
  orgName        String       @unique
  orgDescription String?
  memberships    Membership[]
  boards         Board[]
}

model Membership {
  userId     String
  orgId      String
  memberType String

  user         User         @relation(fields: [userId], references: [userId])
  organization Organization @relation(fields: [orgId], references: [orgId])

  @@id([userId, orgId])
}

model Board {
  boardId      String       @id @default(uuid())
  boardName    String
  orgId        String
  organization Organization @relation(fields: [orgId], references: [orgId])
  sections     Section[]
  issues       Issue[]
}

model Section {
  sectionId    String @id @default(uuid())
  sectionTitle String
  boardId      String

  board  Board   @relation(fields: [boardId], references: [boardId])
  issues Issue[]
}

model Issue {
  issueId          String  @id @default(uuid())
  issueName        String
  issueDescription String?
  boardId          String
  sectionId        String

  board Board @relation(fields: [boardId], references: [boardId])

  section Section @relation(fields: [sectionId], references: [sectionId])

  assignees IssueMapping[]
}

model IssueMapping {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [issueId])

  user User @relation(fields: [userId], references: [userId])

  @@id([issueId, userId])
}
